# App Settings
APP_NAME=RAG-PDF-System
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1

# Security —— 生产必须替换为随机值,留默认会被启动校验拒绝
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ══════════════════════════════════════════════════════════════════════
# 常规启动配置示例，不包含本机凭据，也不声称模型免费或已验证。
# .env供常规启动，实验profile可独立覆盖；见docs/glm-default-switch-20261027.md。
# 常规问答/Agent均使用RightAPI GLM；私有profile仍只交给专用评测子进程。
# GLM用于生成与推理；embedding/rerank使用独立专用模型，不由LLM端点替代。
# ══════════════════════════════════════════════════════════════════════

# 阿里云凭据：Qwen原生问答、向量回退与重排可使用；是否调用取决于实际路径。
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 对话与Agent模型: RightAPI ──
LLM_API_BASE=https://www.rightapi.ai/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

AGENT_MODEL=glm-5.3-flash             # Agent 主推理(诊断规划/执行/报告)
AGENT_MODEL_SIMPLE=glm-5.3-flash      # 简单意图降本用
LLM_MODEL=glm-5.3-flash               # RAG 问答路径默认对话模型
EVIDENCE_LLM_MODEL=glm-5.3-flash      # 证据裁判(ENABLE_LLM_EVIDENCE_JUDGE 默认关)
# 前端模型选择器白名单: chat.py 用它校验,不在此列表的模型会被拒
AVAILABLE_MODELS=glm-5.3-flash
MODEL_DISPLAY_NAMES=GLM-5.3-Flash

# True会发送供应商相关thinking.type=disabled；不是通用兼容保证。
# RightAPI测试profile为False，实际工具/结构化输出兼容性仍待验。
AGENT_DISABLE_THINKING=False

# 旧动态分类兼容开关，不是当前自主调查两机制的总开关。
# create_replanner在自主调查状态下可委托InvestigationStrategy，具体调用路径决定策略。
ENABLE_DYNAMIC_CLASSIFICATION=True

# ── 旧策略消融（保留兼容，不作为当前四组主实验开关） ──
# 旧保护开关同时控制弱信号和复活；当前使用INVESTIGATION_*两个独立机制。
ABLATION_DISABLE_HYPOTHESIS_PROTECTION=false   # 关假设保护(弱信号保护 + 深度回溯复活)
ABLATION_DISABLE_EVIDENCE_GATE=false           # 关证据门控(不再把结论降级为"推测")
ABLATION_DISABLE_DEGRADATION_LABEL=false       # 关降级标注(不披露证据来源可用性/降级来源)

# ── 向量 / rerank: 保持千问,勿改成 DeepSeek ──
# embedding 走 dashscope 原生 SDK(TextEmbedding);换模型必须同步 MILVUS_DIMENSION
# 与 scripts/index_runbooks.py 的维度校验。
EMBEDDING_MODEL=qwen3.7-text-embedding
RERANK_MODEL=qwen3.7-text-rerank

# Milvus (Vector DB)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=rag_documents_v2
MILVUS_DIMENSION=1024

# Redis (Celery Broker & Cache)
REDIS_URL=redis://localhost:6379/0

# Paths
UPLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed
VECTOR_DIR=./data/vectors

# ── 多智能体协同(Supervisor / HITL / 并行观测)──
# Supervisor 统一入口(注册 /api/v1/supervisor/chat),论文实验开启
ENABLE_SUPERVISOR=false
# 人在回路: 诊断结论 respond 前挂起,等待人工审批(POST /aiops/{thread_id}/review)
ENABLE_HITL=false
# pending_review 挂起超时(秒),超时自动落库为"已出草稿、未人工确认"
HITL_TTL_SECONDS=600
# 并行观测采集: executor 对 [并行] 标记步骤并发执行(指标/日志)
ENABLE_PARALLEL_OBSERVATION=false

# 证据裁判 LLM 语义裁判(默认关,走规则关键词;论文实验可开)
ENABLE_LLM_EVIDENCE_JUDGE=false

# ══════════════════════════════════════════════════════════════════════
# MCP 真实后端连接参数(Mock → 真实 双轨)
#   1) 填好 URL / 凭据  2) 把对应 *_BACKEND 从 mock 改成真实值
#   3) 重启对应 MCP 进程(monitor_server.py / cls_server.py / change_server.py)
#   4) 验证: python scripts/probes/probe_real_backends.py
# 生产纪律: 配置了真实后端(指标 prometheus / 日志 elasticsearch)却不可达时,
#           **不回退 mock** —— 如实返回 data_source=unavailable,绝不拿编造的
#           指标/日志/变更当真实证据(实测中 Mock 日志的 OOM 堆栈曾让 Agent 编出错误根因)。
# ══════════════════════════════════════════════════════════════════════

# ── 监控后端: Prometheus ──
MONITOR_BACKEND=prometheus
# 本地真实栈(docker/docker-compose.observability.yml)地址;换生产集群只改这一行。
# 注意: 宿主端口是 19090 不是 9090 —— 9090 落在 Windows Hyper-V 保留段 9029-9128,
#       从 Windows 侧连不上(容器内仍是 9090,只映射到宿主 19090)
PROMETHEUS_URL=http://127.0.0.1:19090
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
# 有前置网关(Thanos/nginx)时填,设置后优先于用户名密码
PROMETHEUS_BEARER_TOKEN=
# 自签证书的内网环境可置 False
PROMETHEUS_VERIFY_SSL=True
PROMETHEUS_TIMEOUT_SECONDS=5.0
# PromQL 模板: {service} 是**值**占位(经 service_map 展开成候选正则,勿手写 | );
#   标签键(instance / service / pod ...)由你按集群实际改 —— 这是适配生产的关键。
#   不确定集群里指标叫什么、服务名挂在哪个标签上:
#       python scripts/discover_prometheus_metrics.py 你的服务名
PROMETHEUS_CPU_PROMQL=clamp_min(100 - avg(rate(node_cpu_seconds_total{mode="idle", instance=~"{service}.*"}[5m])) * 100, 0)
PROMETHEUS_MEMORY_PROMQL=100 * (1 - node_memory_MemAvailable_bytes{instance=~"{service}.*"} / node_memory_MemTotal_bytes{instance=~"{service}.*"})

# ── 日志后端: Elasticsearch ──
CLS_BACKEND=elasticsearch
# 本地真实栈地址;换生产集群只改这一行
CLS_ES_URL=http://127.0.0.1:9200
CLS_ES_USERNAME=
CLS_ES_PASSWORD=
# 集群启用安全功能时填,设置后优先于用户名密码
CLS_ES_API_KEY=
CLS_ES_VERIFY_SSL=True
CLS_TIMEOUT_SECONDS=5.0
# 服务名 → 索引模式;{service} 为归一化后的服务名占位
CLS_INDEX_PATTERN={service}-logs-*
# 日志字段映射: 真实平台字段名 → timestamp / level / message
CLS_LOG_TIMESTAMP_FIELD=@timestamp
CLS_LOG_LEVEL_FIELD=level
CLS_LOG_MESSAGE_FIELD=message

# ── 变更/发布事件后端: Elasticsearch(复用日志同集群)──
# CHANGE_ES_URL 留空 → 自动回退 CLS_ES_URL(同集群不同索引,零额外部署);
# 变更事件是与指标/日志正交的独立证据源,用于"故障时间 ↔ 变更时间"对齐。
# 无 mock 回退: 后端不可达时如实返回"数据不可用",绝不编造变更记录。
CHANGE_ES_URL=
CHANGE_INDEX_PATTERN=change-events-*
CHANGE_TIMESTAMP_FIELD=@timestamp
CHANGE_SERVICE_FIELD=service
CHANGE_ID_FIELD=change_id
CHANGE_TYPE_FIELD=change_type
CHANGE_OPERATOR_FIELD=operator
CHANGE_VERSION_FIELD=version
CHANGE_DESCRIPTION_FIELD=description
CHANGE_STATUS_FIELD=status
CHANGE_TIMEOUT_SECONDS=5.0

# ── 服务名别名表(口头名 ↔ 监控 instance 前缀 ↔ 日志索引前缀)──
# 单行 JSON;键 = 用户可能说出的名字,值 = 各后端的真实名前缀(支持数组展开新旧实例)
# 例: {"订单服务":{"monitor":["order-svc","order-service"],"logs":["order-service-logs-*"]}}
SERVICE_ALIASES={}

# ── 切换真实后端的顺序(重要)──
# 1) 起本地真实栈: docker compose -f docker/docker-compose.observability.yml up -d
# 2) 灌演示日志/变更样本:
#       python scripts/seed_es_demo_logs.py
#       python scripts/seed_es_change_events.py
# 3) 验证连通:     python scripts/probes/probe_real_backends.py  (Prometheus 需等 1~2 分钟采够样本)
# 4) 全部 [ OK ] 后,把 MONITOR_BACKEND 置 prometheus、CLS_BACKEND 置 elasticsearch,
#    并重启 monitor_server.py / cls_server.py / change_server.py(探活只在进程启动时做一次)。
# 为什么开关不能提前切: 真实后端不可达时**不会**回退 mock;ES 活着但索引为空属于正常返回空,
# 提前切会导致日志查询查不到数据 —— 所以先灌数据、探测通过再切。
# ── 补齐Settings中此前未列出的配置；未设置时原代码默认值仍有效 ──
# BASE_DIR仅供显式根路径使用；从项目根目录启动时 . 指向项目根。
# UPLOAD_DIR/PROCESSED_DIR/VECTOR_DIR分别有自己的默认值，不随BASE_DIR覆写自动重算。
BASE_DIR=.
ALLOWED_ORIGINS=
ALLOWED_HOSTS=*
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
EMBEDDING_BATCH_SIZE=20
EMBEDDING_MAX_BATCH_SIZE=25

# 在线embedding独立配置；同时提供base/key时走兼容服务；空则回退DashScope
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=rag-documents
MINIO_SECURE=false

# 持久化路径（本机常规运行）；实验入口会使用独立目录
DATABASE_URL=sqlite:///./rag_system.db
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=20
RAG_MIN_SCORE=0.1
ENABLE_RERANK=true
RERANK_TOP_N=5

# 知识作用范围：空值为未限制；本地BM25知识库ID应按实际数据库核实
EXPERIENCE_KB_IDS=
EXPERIENCE_MIN_SCORE=0.3
ENABLE_MULTI_HOP=true
MAX_HOP=3
DISABLED_TOOL_GUARDS=

# 调用/上下文/轨迹设置，模型重试可能增加请求次数
ENABLE_LLM_RETRY=true
LLM_RETRY_MAX_ATTEMPTS=3
ENABLE_CONTEXT_COMPACTION=false
ENABLE_SKILL_ROUTING=false
ENABLE_STEP_SNAPSHOTS=false
ENABLE_RAW_EVIDENCE_FOR_JUDGE=false
ENABLE_CONFIDENCE_CALIBRATION=false
BELIEF_SOFTMAX_TEMPERATURE=3.0

# 当前四组主实验机制：同一实现，仅切换保护/矛盾两个开关
INVESTIGATION_HYPOTHESIS_PROTECTION=true
INVESTIGATION_CONTRADICTION_TRIGGER=true
INVESTIGATION_PROTECTION_STEPS=2
SHORT_TERM_MEMORY_TTL=3600
LONG_TERM_MEMORY_COLLECTION=user_memory
MEMORY_HISTORY_LIMIT=10

# 本机MCP客户端地址；不代表服务已运行
MCP_MONITOR_URL=http://127.0.0.1:8104/mcp
MCP_CLS_URL=http://127.0.0.1:8103/mcp
MCP_RAG_URL=http://127.0.0.1:8105/mcp
MCP_CHANGE_URL=http://127.0.0.1:8106/mcp
MCP_DIAGNOSTIC_URL=http://127.0.0.1:8107/mcp

# 隔离诊断默认关闭；目标白名单JSON不自动启用执行
DIAGNOSTIC_ENABLED=false
DIAGNOSTIC_TOKEN=
DIAGNOSTIC_TARGET_CATALOG={}
MCP_TERMCP_URL=http://127.0.0.1:18766/mcp

# TermCP默认关闭；不包含在当前毕设必达范围
TERMCP_ENABLED=false
TERMCP_APPROVAL_API_URL=http://127.0.0.1:18766
TERMCP_UI_URL=http://127.0.0.1:18765
TERMCP_SSH_PROFILE=test-target
AIOPS_CHECKPOINT_DB_PATH=data/aiops_checkpoints.sqlite

# Windows Probe：默认不启用，客户端.env与独立网关进程环境/TOML分别配置
PROBE_ENABLED=false
PROBE_TARGET_ID=windows-local-01
PROBE_TOKEN=
PROBE_TLS_VERIFY=true
MCP_PROBE_URL=http://127.0.0.1:18767/mcp
PROBE_EVIDENCE_DIR=data/aiops-evidence
MINIO_SOURCE_BUCKET=rag-documents

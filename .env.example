# App Settings
APP_NAME=RAG-PDF-System
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1

# Security
SECRET_KEY=your-super-secret-key-change-it
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM & Embedding (DashScope / Qwen)
# 一把 key 同时覆盖对话 / 向量 / rerank,无需第二把
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 对话模型: 默认 DeepSeek(非 qwen 前缀 → 自动走 compatible-mode,复用上面这把 key)
AGENT_MODEL=deepseek-v4.1-flash          # AIOps 主推理(Planner/Executor/Replanner)
AGENT_MODEL_SIMPLE=deepseek-v4.1-flash   # 注: 该字段目前无代码引用,改它不生效
LLM_MODEL=deepseek-v4.1-flash            # RAG 问答路径默认对话模型
EVIDENCE_LLM_MODEL=deepseek-v4.1-flash   # 证据裁判(ENABLE_LLM_EVIDENCE_JUDGE 默认关)
# 前端模型选择器: chat.py 拿它当白名单校验,不在此列表的模型会被拒
AVAILABLE_MODELS=deepseek-v4.1-flash,deepseek-v4-flash-0731,deepseek-v4-pro-0813
MODEL_DISPLAY_NAMES=DeepSeek-V4.1-Flash,DeepSeek-V4-Flash-0731,DeepSeek-V4-Pro-0813

# 向量 / rerank: 保持千问,勿改成 DeepSeek(百炼上 DeepSeek 无向量模型;
# embedding 走 dashscope 原生 SDK,换模型需同步 MILVUS_DIMENSION)
EMBEDDING_MODEL=text-embedding-v1
RERANK_MODEL=gte-rerank-v2

# Milvus (Vector DB)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=rag_documents
MILVUS_DIMENSION=1536

# Redis (Celery Broker & Cache)
REDIS_URL=redis://localhost:6379/0

# Paths
UPLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed
VECTOR_DIR=./data/vectors

# ── 多智能体协同（Supervisor / HITL / 并行观测）──
# Supervisor 统一入口（注册 /api/v1/supervisor/chat），论文实验开启
ENABLE_SUPERVISOR=false
# 人在回路：诊断结论 respond 前挂起，等待人工审批（POST /aiops/{thread_id}/review）
ENABLE_HITL=false
# pending_review 挂起超时（秒），超时自动落库为"已出草稿、未人工确认"
HITL_TTL_SECONDS=600
# 并行观测采集：executor 对 [并行] 标记步骤并发执行（指标/日志）
ENABLE_PARALLEL_OBSERVATION=false

# ── AIOps 动态分类策略（毕设核心，论文实验开启）──
ENABLE_DYNAMIC_CLASSIFICATION=false
ENABLE_LLM_EVIDENCE_JUDGE=false

# ══════════════════════════════════════════════════════════════════════
# MCP 真实后端连接参数(Mock → 真实 双轨)
#   1) 填好 URL / 凭据  2) *_BACKEND 从 mock 改成真实值
#   3) 重启对应 MCP 进程  4) 验证: python scripts/probe_real_backends.py
# 安全兜底: 开关或 URL 任一为空 → 自动回退 mock 剧本。
# ══════════════════════════════════════════════════════════════════════

# ── 监控后端: Prometheus ──
MONITOR_BACKEND=mock
# 本地真实栈见 docker/docker-compose.observability.yml。若宿主 9090 被 Windows
# 保留段占用(WSL 转发不了),把 compose 里映射改成 19090:9090 并填 19090
PROMETHEUS_URL=
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_BEARER_TOKEN=
PROMETHEUS_VERIFY_SSL=True
PROMETHEUS_TIMEOUT_SECONDS=5.0
PROMETHEUS_CPU_PROMQL=clamp_min(100 - avg(rate(node_cpu_seconds_total{mode="idle", instance=~"{service}.*"}[5m])) * 100, 0)
PROMETHEUS_MEMORY_PROMQL=100 * (1 - node_memory_MemAvailable_bytes{instance=~"{service}.*"} / node_memory_MemTotal_bytes{instance=~"{service}.*"})

# ── 日志后端: Elasticsearch ──
CLS_BACKEND=mock
CLS_ES_URL=
CLS_ES_USERNAME=
CLS_ES_PASSWORD=
CLS_ES_API_KEY=
CLS_ES_VERIFY_SSL=True
CLS_TIMEOUT_SECONDS=5.0
CLS_INDEX_PATTERN={service}-logs-*
CLS_LOG_TIMESTAMP_FIELD=@timestamp
CLS_LOG_LEVEL_FIELD=level
CLS_LOG_MESSAGE_FIELD=message

# ── 服务名别名表(口头名 ↔ 监控 instance 前缀 ↔ 日志索引前缀)──
# 例: {"订单服务":{"monitor":["order-svc","order-service"],"logs":["order-service-logs-*"]}}
SERVICE_ALIASES={}

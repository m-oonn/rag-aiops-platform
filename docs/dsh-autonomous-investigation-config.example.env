# DSH 自主调查只读基线示例
# 这是接线示例，不是可直接部署的完整 .env；沿用应用已有私有配置。
# 确认 Probe 鉴权/白名单/目标一致后再把 false 改成 true。
PROBE_ENABLED=false
PROBE_TARGET_ID=dsh-desktop-01
MCP_PROBE_URL=http://127.0.0.1:18767/mcp
PROBE_TLS_VERIFY=true
PROBE_EVIDENCE_DIR=data/aiops-evidence/dsh-desktop-01
AIOPS_CHECKPOINT_DB_PATH=data/dsh-investigation-checkpoints.sqlite
# PROBE_TOKEN 从私有环境注入，并与实际网关配置一致。
# DIAGNOSTIC_TARGET_CATALOG 按 inventory 和 Probe TOML 实际登记填写。
MONITOR_BACKEND=prometheus
PROMETHEUS_URL=http://127.0.0.1:19090
# 127.0.0.1 地址与 dsh-host 均为接线例子，本轮未验证其在线。
OPS_WATCH_ENABLED=false
OPS_WATCH_SERVICES=dsh-host
OPS_WATCH_INTERVAL_SECONDS=30
OPS_WATCH_STALE_AFTER_SECONDS=120
OPS_WATCH_AUTO_DIAGNOSE=false
ENABLE_STEP_SNAPSHOTS=true
# 填写已建立的专用案例库真实 ID；空值会扩大检索范围，不应盲目照搬。
# EXPERIENCE_KB_IDS=<专用案例库真实ID>
EXPERIENCE_MIN_SCORE=0.30
ENABLE_RAW_EVIDENCE_FOR_JUDGE=true
INVESTIGATION_HYPOTHESIS_PROTECTION=true
INVESTIGATION_CONTRADICTION_TRIGGER=true
INVESTIGATION_PROTECTION_STEPS=2
# 仅表示报告草稿需要人工审核；不是插件修改授权
ENABLE_HITL=true
TERMCP_ENABLED=false

# 以下均为设计建议，当前 Settings 不支持；全部保持注释。
# 采样间隔、时长和阈值仅为实验起点，需要正常基线标定。
# DSH_RUNTIME_EVIDENCE_ENABLED=false
# DSH_TARGET_ID=dsh-desktop-01
# DSH_PLUGIN_ALLOWLIST=dsh-better-sidebar
# DSH_PERF_SAMPLE_SECONDS=10
# DSH_CPU_SAMPLE_INTERVAL_MS=500
# DSH_EVENT_LOOP_MAX_LAG_MS=100
# DSH_EVIDENCE_MAX_AGE_SECONDS=180
# DSH_EVIDENCE_RETENTION_DAYS=30
# DSH_EXPERIMENTS_ENABLED=false
# DSH_REPAIR_MODE=approval_required
